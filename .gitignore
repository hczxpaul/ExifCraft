# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.spec
*.manifest
# ...but the DPI-awareness manifest IS a build input (build.py reads it)
!ExifCraft-X.manifest
*.log

# ---- Tooling caches ----
.mypy_cache/
.ruff_cache/

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- Test / coverage artifacts ----
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# ---- ExifCraft runtime data ----
# .exifcraft/ holds the backup/rollback session journal written at runtime
# (BackupManager in ExifCraft.pyw). Never commit it.
.exifcraft/
# In-place overwrite backups created next to user images:
# ._ExifCraft_bak_<session>_<name>.exifbak
*.exifbak
._ExifCraft_bak_*
# Map tile cache (SQLite): written next to the script when run from source
# and the map picker is used (APP_DIR/map_tiles.db, see ExifCraft.pyw).
# Rebuilt on demand — up to 100 MB of tiles, never source material.
map_tiles.db

# ---- IDE / editor ----
.idea/
.vscode/
*.swp
*.swo

# ---- OS junk ----
desktop.ini
Thumbs.db
.DS_Store
# ---- Local working notes ----
# PLAN_*/BUG_* notes are process artifacts (plans, bug analysis), not project
# docs. Features ship and bugs get fixed; these stay on disk as local history.
# Only README.md belongs in the repo.
PLAN_*.md
BUG_*.md
# Development screenshots: UI captures taken while building each feature
# (checkbox style, empty state, 3-column layout, map picker...). Same nature
# as the notes above — visual process records, referenced by nothing.
# They slipped into the repo by riding along with feature commits on 10-17/18;
# git history keeps them, the working copy stays on disk as local reference.
screenshots/
