# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.spec
*.manifest
# ...but the DPI-awareness manifest IS a build input (build.py reads it)
!ExifCraft.manifest
*.log

# ---- Tooling caches ----
.mypy_cache/
.ruff_cache/

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- Test / coverage artifacts ----
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# ---- ExifCraft runtime data ----
# .exifcraft/ holds the backup/rollback session journal written at runtime
# (BackupManager in ExifCraft.pyw). Never commit it.
.exifcraft/
# In-place overwrite backups created next to user images:
# ._ExifCraft_bak_<session>_<name>.exifbak
*.exifbak
._ExifCraft_bak_*

# ---- IDE / editor ----
.idea/
.vscode/
*.swp
*.swo

# ---- OS junk ----
desktop.ini
Thumbs.db
.DS_Store
